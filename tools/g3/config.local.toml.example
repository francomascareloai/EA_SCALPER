# Project-local G3 config (copy to `tools/g3/config.local.toml`)
#
# IMPORTANT: `tools/g3/config.local.toml` is gitignored because it will contain secrets.

[providers]
# Pick ONE provider below and set it here:
# - "openai.localproxy"     (recommended for this repo: CLIProxyAPI)
# - "anthropic.default"
# - "openai.default"
# - "databricks.default"
default_provider = "openai.localproxy"

# === CLIProxyAPI (OpenAI-compatible) ===
# Runs locally (example: http://127.0.0.1:8317/v1) and accepts a local proxy key.
# Tip: list models with:
#   curl -H "Authorization: Bearer <KEY>" http://127.0.0.1:8317/v1/models
[providers.openai.localproxy]
api_key = "sk-local-proxy-REPLACE_ME"
base_url = "http://127.0.0.1:8317/v1"
model = "gemini-claude-opus-4-5-thinking"
max_tokens = 65536
temperature = 0.2

# === Anthropic (direct) ===
# [providers.anthropic.default]
# api_key = "sk-ant-..."
# model = "claude-sonnet-4-5"
# max_tokens = 64000
# temperature = 0.3

# === OpenAI (direct) ===
# [providers.openai.default]
# api_key = "sk-..."
# model = "gpt-4o"
# max_tokens = 8192
# temperature = 0.2

# === Databricks (direct) ===
# [providers.databricks.default]
# host = "https://your-workspace.cloud.databricks.com"
# token = "dapi..."
# model = "databricks-claude-sonnet-4"
# max_tokens = 32000
# temperature = 0.1
# use_oauth = false

[agent]
# Your EA repo loads a large `AGENTS.md`, so 4096 is too small.
max_context_length = 200000
fallback_default_max_tokens = 8192
enable_streaming = true
allow_multiple_tool_calls = true
timeout_seconds = 300
auto_compact = true
max_retry_attempts = 3
autonomous_max_retry_attempts = 6
check_todo_staleness = true

[computer_control]
enabled = false
require_confirmation = true
max_actions_per_second = 5

[webdriver]
enabled = false
safari_port = 4444

[macax]
enabled = false
